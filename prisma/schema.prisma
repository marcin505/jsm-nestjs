datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

enum Role {
  USER
  ADMIN
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  role      Role   @default(USER) 
  createdAt DateTime @default(now())
}

model Country {
  id        Int      @id @default(autoincrement())
  name      String?
  createdAt DateTime @default(now())
}
