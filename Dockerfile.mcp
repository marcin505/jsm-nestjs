# 1. Budowanie aplikacji
FROM node:22-alpine AS builder
WORKDIR /app
COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile
COPY . .
# Generujemy klienta Prismy i budujemy nasz serwer MCP
RUN npx prisma generate
RUN NODE_OPTIONS="--max-old-space-size=1536" yarn build:mcp

# 2. Uruchamianie aplikacji (lekki obraz produkcyjny)
FROM node:22-alpine
WORKDIR /app
COPY package.json yarn.lock ./
RUN yarn install --production --frozen-lockfile
# Kopiujemy skompilowany serwer oraz wygenerowaną Prismę
COPY --from=builder app/dist-mcp ./dist-mcp
COPY --from=builder app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder app/node_modules/@prisma/client ./node_modules/@prisma/client


# Serwery MCP stdio komunikują się przez standardowe wejście/wyjście
CMD ["node", "dist-mcp/mcp-server.js"]
